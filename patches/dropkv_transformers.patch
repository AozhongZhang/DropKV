+                query_states_last_window = query_states[..., -self.window_size:, :]
+                key_states_repeated = _repeat_kv(key_states, num_key_value_groups)
+                value_states_repeated = _repeat_kv(value_states, num_key_value_groups)
+
+                attn_weights = torch.matmul(query_states_last_window, key_states_repeated.transpose(2, 3)) / math.sqrt(head_dim)
+
+                # Causal mask
+                mask = torch.full((self.window_size, seq_len), float("-inf"), device=attn_weights.device)
+                mask = torch.triu(mask, diagonal=seq_len - self.window_size + 1)
+                attn_weights += mask
+
+                attn_weights = F.softmax(attn_weights, dim=-1, dtype=torch.float32).to(query_states.dtype)
+
+                # Attention output (bf16 matmul)
+                y = torch.matmul(attn_weights, value_states_repeated)
+
+                # Score computation in fp32 for numerical stability and Triton parity.
+                # The bf16 softmax cast above is the critical precision point —
+                # p near 1.0 rounds differently in bf16 vs fp32.
+                eps = 1e-6
+                attn_f = attn_weights.float()
+                W = (attn_f / (1.0 - attn_f + eps)) ** 2
+
+                # Term A = (sum_q W) * ||v||^2
+                W_sum = W.sum(dim=-2)
+                v_norm2 = (value_states_repeated.float() ** 2).sum(dim=-1)
+                termA = W_sum * v_norm2
+
+                # Term B = 2 * <v, W^T y>
+                WT_y = torch.matmul(W.transpose(-1, -2), y.float())
+                termB = 2.0 * torch.sum(value_states_repeated.float() * WT_y, dim=-1)
+
+                # Term C = W^T ||y||^2
+                y_norm2 = (y.float() ** 2).sum(dim=-1)
+                termC = torch.matmul(W.transpose(-1, -2), y_norm2.unsqueeze(-1)).squeeze(-1)
+
+                # Final scores (fp32)
+                scores = termA - termB + termC
+                scores = scores.view(bsz, num_kv_heads, num_key_value_groups, -1)
+                scores = scores.mean(dim=2)
+
+            # Smooth with max_pool1d
+            scores = F.max_pool1d(scores, kernel_size=self.kernel_size, padding=self.kernel_size // 2, stride=1)
+
+            # Protect last window_size tokens
+            big = scores.amax(dim=-1, keepdim=True) + 1.0
+            if self.window_size > 0:
+                scores[:, :, -self.window_size:] = big
+
+            # TopK selection
+            keep_len = max(int(self.keep_ratio * seq_len), self.window_size, 1)
+            keep_idx = torch.topk(scores, k=keep_len, dim=-1, largest=True).indices
+            keep_idx, _ = torch.sort(keep_idx, dim=-1)
+
+            # Gather compressed KV
+            keep_idx_expanded = keep_idx.unsqueeze(-1).expand(-1, -1, -1, head_dim)
+            key_states_compressed = torch.gather(key_states, dim=2, index=keep_idx_expanded)
+            value_states_compressed = torch.gather(value_states, dim=2, index=keep_idx_expanded)
+
+            # Store compressed KV in cache
+            self.keys = key_states_compressed
+            self.values = value_states_compressed
+
+            # Return FULL KV for this layer's attention computation
+            return key_states, value_states
+
+        # --- Phase 2: Decode (subsequent tokens) ---
+        else:
+            # Once we append without eviction, lock out late prefill to prevent
+            # a future query_states arrival from overwriting accumulated KV.
+            self._prefilled = True
+            self.keys = torch.cat([self.keys, key_states], dim=-2)
+            self.values = torch.cat([self.values, value_states], dim=-2)
+            return self.keys, self.values
+
+    def get_seq_length(self) -> int:
+        """Returns the logical sequence length (total tokens seen), not the stored tensor length.
+
+        After eviction the stored KV is shorter than the true sequence length.
+        RoPE position computation relies on this returning the logical length so that
+        decode tokens receive correct positional embeddings.
+        """
+        return self.cumulative_length if self.is_initialized else 0
+
+    def get_mask_sizes(self, cache_position: torch.Tensor) -> tuple[int, int]:
+        """Return (kv_length, kv_offset) matching the stored KV dimensions.
+
+        The attention mask must match the actual stored tensor size, not the logical
+        length, so we use the stored key tensor length here.
+        """
+        kv_offset = 0
+        query_length = cache_position.shape[0]
+        stored_len = 0 if (not self.is_initialized or self.keys.numel() == 0) else self.keys.shape[-2]
+        kv_length = stored_len + query_length
+        return kv_length, kv_offset
+
+
+class DropKVCache(Cache):
+    """
+    KV cache with attention-output-based eviction (DropKV). During prefill, each layer compresses
+    the KV cache by scoring positions using attention-output sensitivity and keeping only the top fraction.
+    During decode, it appends new tokens like a standard dynamic cache.
+
+    Args:
+        config (`PreTrainedConfig`): Model config (used to determine number of layers).
+        keep_ratio (`float`): Fraction of KV pairs to retain after prefill eviction. Default: 0.1
+        window_size (`int`): Number of recent tokens always kept and used for scoring. Default: 8
+        kernel_size (`int`): Smoothing kernel size for score averaging. Default: 11
+        use_triton (`bool`): Use Triton kernels for scoring (falls back to PyTorch if unavailable). Default: True
+    """
+
+    def __init__(
+        self,
+        config: PreTrainedConfig,
+        keep_ratio: float = 0.1,
+        window_size: int = 8,
+        kernel_size: int = 11,
+        use_triton: bool = True,
+    ):
+        config = config.get_text_config(decoder=True)
+        layers = [
+            DropKVLayer(keep_ratio=keep_ratio, window_size=window_size, kernel_size=kernel_size, use_triton=use_triton)
+            for _ in range(config.num_hidden_layers)
+        ]
+        super().__init__(layers=layers)
+
