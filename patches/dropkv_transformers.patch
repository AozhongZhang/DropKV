+def _repeat_kv(hidden_states: torch.Tensor, n_rep: int) -> torch.Tensor:
+    """Expand KV heads to match query heads for GQA: (batch, num_kv_heads, seqlen, head_dim) -> (batch, num_query_heads, seqlen, head_dim)."""
+    batch, num_key_value_heads, slen, head_dim = hidden_states.shape
+    if n_rep == 1:
+        return hidden_states
+    hidden_states = hidden_states[:, :, None, :, :].expand(batch, num_key_value_heads, n_rep, slen, head_dim)
+    return hidden_states.reshape(batch, num_key_value_heads * n_rep, slen, head_dim)
+
+
+class DropKVLayer(DynamicLayer):
+    """
+    A cache layer that performs attention-output-based KV cache eviction during prefill.
+    During prefill, it scores each KV position using an attention-output sensitivity metric
+    and keeps only the top-k fraction. During decode, it behaves like a standard DynamicLayer.
+    """
+
+    def __init__(self, keep_ratio: float = 0.1, window_size: int = 8, kernel_size: int = 11, use_triton: bool = True):
+        super().__init__()
+        if not 0 < keep_ratio <= 1.0:
+            raise ValueError(f"keep_ratio must be in (0, 1], got {keep_ratio}")
+        self.keep_ratio = keep_ratio
+        if window_size <= 0:
+            raise ValueError(f"window_size must be positive, got {window_size}")
+        self.window_size = window_size
+        if kernel_size < 1 or kernel_size % 2 == 0:
+            raise ValueError(f"kernel_size must be a positive odd integer, got {kernel_size}")
+        self.kernel_size = kernel_size
+        self.use_triton = use_triton
+        self._prefilled = False
+        self.cumulative_length = 0
+        self._warned_no_query = False
+
+    def reset(self) -> None:
+        """Reset cache state for a new generation."""
+        super().reset()
+        self._prefilled = False
+        self._warned_no_query = False
+        # Re-initialize to empty tensors (not just zeroed from base class)
+        if self.is_initialized:
+            self.keys = torch.tensor([], dtype=self.dtype, device=self.device)
+            self.values = torch.tensor([], dtype=self.dtype, device=self.device)
+
+    def crop(self, max_length: int) -> None:
+        """Crop stored KV and sync cumulative_length."""
+        super().crop(max_length)
+        # After crop, logical length must match stored length
+        stored = 0 if (not self.is_initialized or self.keys.numel() == 0) else self.keys.shape[-2]
+        self.cumulative_length = stored
+
+    def update(
+        self,
+        key_states: torch.Tensor,
+        value_states: torch.Tensor,
+        cache_kwargs: dict[str, Any] | None = None,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        # Lazy initialization
+        if not self.is_initialized:
+            self.lazy_initialization(key_states, value_states)
+
+        # Track true number of tokens seen (stored length may differ after eviction)
+        self.cumulative_length += key_states.shape[-2]
+
+        # --- Phase 1: Prefill (first call with query_states available) ---
+        query_states = cache_kwargs.get("query_states") if cache_kwargs is not None else None
+        if query_states is None and not self._prefilled and not self._warned_no_query:
+            self._warned_no_query = True
+            logger.warning_once(
+                "DropKVLayer received no query_states in cache_kwargs. Eviction will not occur. "
+                "Make sure the model's attention layer passes query_states in cache_kwargs."
+            )
+        if not self._prefilled and query_states is not None:
+            self._prefilled = True
+
+            bsz, num_kv_heads, seq_len, head_dim = key_states.shape
+            num_query_heads = query_states.shape[1]
+
+            if seq_len < self.window_size:
+                # Sequence too short for scoring — store full KV, skip eviction
+                self.keys = key_states
+                self.values = value_states
